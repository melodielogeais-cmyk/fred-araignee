# Copier en .env et remplir. Ne jamais committer le vrai .env.
# Cerveau : grok (défaut), claude ou regles (gratuit, sans IA)
CERVEAU=grok
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Notifications Telegram (optionnel)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Protège le tableau de bord (utilisateur : araignee) quand il est sur un serveur
DASHBOARD_PASSWORD=
